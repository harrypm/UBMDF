/target
# Firmware payload: installers, extracts, inventories (~30+ GB, regenerable
# via tools/harvest.ps1; the index itself is rebuilt from disk)
# Firmware: flashable bundles + raw extracted installer data are tracked
# (binaries via Git LFS, see .gitattributes). Excluded: installer zips
# (27 GB, re-downloadable from Blackmagic's catalog) and msiexec leftovers.
/firmware/installers/*.zip
/firmware/installers/*-full/
/firmware/installers/**/sandbox/
/firmware/installers/**/*.msi
# Runtime state
/logs/ubmdf.log
/ubmdf-gui.conf
/tools/harvest-transcript.log
/tools/inspect-msi.log
/dumps
/tools/updater-extract.log
__pycache__/
/dist
# pre-rename (UBDMF <= v1.0.0) runtime files
/logs/ubdmf.log
/ubdmf-gui.conf
# usbtrace build output (tools/usbtrace/build.sh)
/tools/usbtrace/*.dylib
